work/
extracted/
dump/
dumps/
assets_dumped/

# --- Recompiler output (only the README is tracked) ---
generated/*
!generated/README.md

# --- Ghidra / analysis artifacts ---
*.gzf
*.rep/
*.gpr
*.lock
*.lock~
# Derived analysis output (commit policy for *.toml/*.csv still pending)
analysis/out/
analysis/*.toml
analysis/*.csv

# --- CMake / C++ build output ---
build/
out/
cmake-build-*/
CMakeUserPresets.json
CMakeCache.txt
CMakeFiles/
compile_commands.json
*.obj
*.o
*.lib
*.a
*.pdb
*.ilk
*.exe
*.dll
*.so
*.dylib

# --- Runtime logs (PS2Recomp writes guest call traces to the working directory) ---
ps2_log.txt

# --- Editors / OS ---
.vs/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Env / secrets ---
.env
.env.*

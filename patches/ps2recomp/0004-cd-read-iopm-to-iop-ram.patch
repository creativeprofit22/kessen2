+    // sceCdReadIOPm(lbn, sectors, buf, mode): like sceCdRead, but buf is an IOP
+    // address, so the sectors must land in IOP RAM (not EE RDRAM).
     void sceCdReadIOPm(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
     {
-        sceCdRead(rdram, ctx, runtime);
+        const uint32_t lbn = getRegU32(ctx, 4);
+        const uint32_t sectors = getRegU32(ctx, 5);
+        const uint32_t iopAddress = getRegU32(ctx, 6) & 0x1FFFFFu;
+        const uint64_t bytes = static_cast<uint64_t>(sectors) * kCdSectorSize;
+
+        if (runtime == nullptr || bytes == 0u || !runtime->isIopMemoryRange(iopAddress, static_cast<size_t>(bytes)))
+        {
+            std::cerr << "[sceCdReadIOPm] rejected lbn=0x" << std::hex << lbn << " sectors=" << std::dec << sectors
+                      << " iop=0x" << std::hex << iopAddress << std::dec << std::endl;
+            g_lastCdError = -1;
+            setReturnS32(ctx, 0);
+            return;
+        }
+
+        std::vector<uint8_t> data(static_cast<size_t>(bytes));
+        if (!readCdSectors(lbn, sectors, data.data(), data.size()) ||
+            !runtime->writeIopMemory(iopAddress, data.data(), data.size()))
+        {
+            setReturnS32(ctx, 0);
+            return;
+        }
+
+        g_cdStreamingLbn = lbn + sectors;
+        setReturnS32(ctx, 1);
     }
 

+// The IPU is not emulated: sceMpeg* is high-level and decodes from the demuxed stream.
+// A toIPU (channel 4) transfer is therefore drained at once: MADR/TADR/QWC advance as if
+// the IPU had consumed every tag, STR clears and the channel completes. Games that feed
+// their own IPU ring and track its progress through D4_MADR/CHCR.STR then see it drain
+// instead of waiting forever.
+bool PS2Memory::tryProcessIpuToDma(uint32_t channelBase, uint32_t chcr)
+{
+    static constexpr uint32_t kIpuToChannel = 0x1000B400u;
+    static constexpr uint32_t kIpuToCause = 4u;
+    static constexpr int kMaxChainTags = 4096;
+    if (channelBase != kIpuToChannel)
+        return false;
+
+    uint32_t madr = m_ioRegisters[channelBase + 0x10u];
+    const uint32_t qwc = m_ioRegisters[channelBase + 0x20u] & 0xFFFFu;
+    uint32_t tadr = m_ioRegisters[channelBase + 0x30u];
+    uint32_t lastTagUpper = chcr >> 16u;
+    madr += qwc * 16u;
+
+    if (((chcr >> 2u) & 0x3u) == 1u) // source chain
+    {
+        const bool tieEnabled = (chcr & (1u << 7u)) != 0u;
+        for (int i = 0; i < kMaxChainTags; ++i)
+        {
+            const bool tagInScratchpad = isScratchpad(tadr);
+            const uint32_t tagPhys = translateAddress(tadr);
+            const uint8_t *tagBase = tagInScratchpad ? m_scratchpad : m_rdram;
+            const uint32_t tagMax = tagInScratchpad ? PS2_SCRATCHPAD_SIZE : PS2_RAM_SIZE;
+            if (tagPhys > tagMax - 16u)
+                break;
+
+            uint64_t tag = 0u;
+            std::memcpy(&tag, tagBase + tagPhys, sizeof(tag));
+            const uint32_t tagQwc = static_cast<uint32_t>(tag & 0xFFFFu);
+            const uint32_t id = static_cast<uint32_t>((tag >> 28u) & 0x7u);
+            const bool irq = ((tag >> 31u) & 0x1u) != 0u;
+            const uint32_t addr = static_cast<uint32_t>((tag >> 32u) & 0x7FFFFFFFu);
+            lastTagUpper = static_cast<uint32_t>((tag >> 16u) & 0xFFFFu);
+
+            uint32_t dataAddr = 0u;
+            bool endChain = false;
+            switch (id)
+            {
+            case 0u: // refe
+                dataAddr = addr;
+                tadr += 16u;
+                endChain = true;
+                break;
+            case 1u: // cnt
+                dataAddr = tadr + 16u;
+                tadr = dataAddr + tagQwc * 16u;
+                break;
+            case 2u: // next
+                dataAddr = tadr + 16u;
+                tadr = addr;
+                break;
+            case 3u: // ref
+            case 4u: // refs
+                dataAddr = addr;
+                tadr += 16u;
+                break;
+            case 7u: // end
+                dataAddr = tadr + 16u;
+                endChain = true;
+                break;
+            default: // call/ret are not valid for a source channel without a stack
+                dataAddr = tadr + 16u;
+                endChain = true;
+                break;
+            }
+            madr = dataAddr + tagQwc * 16u;
+            if (endChain || (irq && tieEnabled))
+                break;
+        }
+    }
+
+    m_ioRegisters[channelBase + 0x10u] = madr;
+    m_ioRegisters[channelBase + 0x20u] = 0u;
+    m_ioRegisters[channelBase + 0x30u] = tadr;
+    m_ioRegisters[channelBase] = (chcr & 0x0000FFFFu) | (lastTagUpper << 16u);
+    completeDmacChannel(channelBase, kIpuToCause);
+    return true;
+}

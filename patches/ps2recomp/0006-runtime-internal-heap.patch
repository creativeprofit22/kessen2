+uint32_t PS2Runtime::internalMalloc(uint32_t size, uint32_t alignment)
+{
+    if (size == 0u || size > (kInternalHeapLimit - kInternalHeapBase))
+    {
+        return guestMalloc(size, alignment);
+    }
+    const uint32_t normalizedAlignment = normalizeGuestHeapAlignment(alignment);
+    const uint32_t allocSize = alignGuestHeapValue(size, kGuestHeapDefaultAlignment);
+    {
+        std::lock_guard<std::mutex> lock(m_guestHeapMutex);
+        // First fit; blocks stay sorted by address and cover the whole arena.
+        for (size_t i = 0; i < m_internalHeapBlocks.size(); ++i)
+        {
+            const GuestHeapBlock block = m_internalHeapBlocks[i];
+            if (!block.free)
+            {
+                continue;
+            }
+            const uint32_t start = alignGuestHeapValue(block.addr, normalizedAlignment);
+            const uint32_t blockEnd = block.addr + block.size;
+            if (start < block.addr || start >= blockEnd || blockEnd - start < allocSize)
+            {
+                continue;
+            }
+            std::vector<GuestHeapBlock> replacement;
+            if (start > block.addr)
+            {
+                replacement.push_back({block.addr, start - block.addr, true});
+            }
+            replacement.push_back({start, allocSize, false});
+            if (start + allocSize < blockEnd)
+            {
+                replacement.push_back({start + allocSize, blockEnd - (start + allocSize), true});
+            }
+            m_internalHeapBlocks.erase(m_internalHeapBlocks.begin() + static_cast<std::ptrdiff_t>(i));
+            m_internalHeapBlocks.insert(m_internalHeapBlocks.begin() + static_cast<std::ptrdiff_t>(i),
+                                        replacement.begin(), replacement.end());
+            return start;
+        }
+    }
+    return guestMalloc(size, alignment);
+}

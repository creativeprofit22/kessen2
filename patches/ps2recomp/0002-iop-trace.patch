diff --git a/ps2xIOP/src/emulator/iop_trace.h b/ps2xIOP/src/emulator/iop_trace.h
new file mode 100644
index 0000000..51b70f1
--- /dev/null
+++ b/ps2xIOP/src/emulator/iop_trace.h
@@ -0,0 +1,119 @@
+#pragma once
+
+// Opt-in diagnostic trace for the IOP emulator, configured from the environment:
+//   PS2X_IOP_TRACE       comma list of: imports, spu2, rpc, all (unset = off)
+//   PS2X_IOP_TRACE_LIBS  comma list of import libraries to trace
+//                        (default: every library except sysclib and stdio)
+//   PS2X_IOP_TRACE_MAX   maximum trace lines (default 200000)
+// When off, the emulator behaves exactly as without the trace.
+
+#include <cstdint>
+#include <cstdlib>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    struct IopTraceConfig
+    {
+        bool imports = false;
+        bool spu2 = false;
+        bool rpc = false;
+        std::vector<std::string> libraries;
+        bool librariesExplicit = false;
+        uint64_t maxLines = 200000u;
+
+        [[nodiscard]] bool any() const noexcept { return imports || spu2 || rpc; }
+
+        [[nodiscard]] bool traceLibrary(std::string_view library) const
+        {
+            bool listed = false;
+            for (const std::string &entry : libraries)
+                listed = listed || equalsIgnoreCase(entry, library);
+            return librariesExplicit ? listed : !listed;
+        }
+
+        [[nodiscard]] static IopTraceConfig fromEnvironment()
+        {
+            IopTraceConfig config;
+            for (const std::string &item : splitList(environment("PS2X_IOP_TRACE")))
+            {
+                const bool all = equalsIgnoreCase(item, "all");
+                config.imports = config.imports || all || equalsIgnoreCase(item, "imports");
+                config.spu2 = config.spu2 || all || equalsIgnoreCase(item, "spu2");
+                config.rpc = config.rpc || all || equalsIgnoreCase(item, "rpc");
+            }
+            const std::string libraries = environment("PS2X_IOP_TRACE_LIBS");
+            if (!libraries.empty())
+            {
+                config.libraries = splitList(libraries);
+                config.librariesExplicit = true;
+            }
+            else
+            {
+                config.libraries = {"sysclib", "stdio"};
+            }
+            const std::string maxLines = environment("PS2X_IOP_TRACE_MAX");
+            if (!maxLines.empty())
+            {
+                char *end = nullptr;
+                const unsigned long long parsed = std::strtoull(maxLines.c_str(), &end, 10);
+                if (end != maxLines.c_str() && *end == '\0')
+                    config.maxLines = parsed;
+            }
+            return config;
+        }
+
+    private:
+        static std::string environment(const char *name)
+        {
+#if defined(_MSC_VER)
+            char *value = nullptr;
+            size_t length = 0;
+            if (_dupenv_s(&value, &length, name) != 0 || value == nullptr)
+                return {};
+            std::string result(value);
+            std::free(value);
+            return result;
+#else
+            const char *value = std::getenv(name);
+            return value ? std::string(value) : std::string();
+#endif
+        }
+
+        static std::vector<std::string> splitList(std::string_view text)
+        {
+            std::vector<std::string> items;
+            while (!text.empty())
+            {
+                const size_t comma = text.find(',');
+                std::string_view item = text.substr(0, comma);
+                while (!item.empty() && (item.front() == ' ' || item.front() == '\t'))
+                    item.remove_prefix(1);
+                while (!item.empty() && (item.back() == ' ' || item.back() == '\t'))
+                    item.remove_suffix(1);
+                if (!item.empty())
+                    items.emplace_back(item);
+                if (comma == std::string_view::npos)
+                    break;
+                text.remove_prefix(comma + 1);
+            }
+            return items;
+        }
+
+        static bool equalsIgnoreCase(std::string_view lhs, std::string_view rhs)
+        {
+            if (lhs.size() != rhs.size())
+                return false;
+            for (size_t i = 0; i < lhs.size(); ++i)
+            {
+                const auto lower = [](char ch)
+                { return (ch >= 'A' && ch <= 'Z') ? static_cast<char>(ch - 'A' + 'a') : ch; };
+                if (lower(lhs[i]) != lower(rhs[i]))
+                    return false;
+            }
+            return true;
+        }
+    };
+}

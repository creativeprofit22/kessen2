{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "msvc-x64",
      "displayName": "Windows x64 (Visual Studio 17 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/msvc-x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "msvc-x64-debug", "configurePreset": "msvc-x64", "configuration": "Debug" },
    { "name": "msvc-x64-release", "configurePreset": "msvc-x64", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "msvc-x64",
      "configurePreset": "msvc-x64",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
